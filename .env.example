# ========================================================
# IIT Kharagpur BS Portal - Secure Environment Configuration Template
# ========================================================
# IMPORTANT: Generate strong random secrets for production. Never commit actual .env files!

# Environment Mode (production / development)
NODE_ENV=production

# Server Port
PORT=5000

# PostgreSQL Database Configuration
POSTGRES_USER=iitkgp_app
POSTGRES_PASSWORD=GENERATE_STRONG_DB_PASSWORD_HERE
POSTGRES_DB=iitkgp_bs_portal
POSTGRES_PORT=5432

# Database Connection URL (Used by Backend)
# For local Docker:
DATABASE_URL=postgres://iitkgp_app:GENERATE_STRONG_DB_PASSWORD_HERE@db:5432/iitkgp_bs_portal
# For external cloud database (e.g. Supabase / Neon / AWS RDS):
# DATABASE_URL=postgres://user:password@host.cloud.com:5432/dbname?sslmode=require

# Application Secrets (Must be at least 32 characters, cryptographically random)
# Generate with: openssl rand -hex 32
SESSION_SECRET=GENERATE_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARS
JWT_SECRET=GENERATE_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS

# Allowed CORS Origins (Comma-separated exact domains; never use * in production!)
CORS_ORIGIN=http://localhost:5173,http://localhost:5000,https://hcdskgp.com

# Optional External AI API Key (Stored safely on backend, never exposed to client)
# GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Environment Variables (Vite build-time)
VITE_API_URL=http://localhost:5000/api

