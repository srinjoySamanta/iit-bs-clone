# ========================================================
# IIT Kharagpur BS Portal - Environment Variables Template
# ========================================================
# Copy this file to .env for local Docker Compose or configure these in your cloud host.

# Environment Mode
NODE_ENV=production

# Server Port
PORT=5000

# PostgreSQL Database Configuration
POSTGRES_USER=iitkgp_admin
POSTGRES_PASSWORD=iitkgp_secure_password_2026
POSTGRES_DB=iitkgp_bs_portal
POSTGRES_PORT=5432

# Database Connection URL (Used by Backend)
# For local Docker:
DATABASE_URL=postgres://iitkgp_admin:iitkgp_secure_password_2026@db:5432/iitkgp_bs_portal
# For external cloud database (e.g. Render / Supabase / Neon / AWS RDS):
# DATABASE_URL=postgres://user:password@host.cloud.com:5432/dbname?sslmode=require

# Application Secrets
SESSION_SECRET=iit_kharagpur_super_secret_session_key_2026
JWT_SECRET=super_secret_jwt_key_iitkgp_bs_2026

# Allowed CORS Origin (Frontend URL in split deployments, or * for unified)
CORS_ORIGIN=*

# Frontend Environment Variables (Vite build-time)
VITE_API_URL=http://localhost:5000/api
